# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# ---------------------------------------------------------------------------
# SQL Server (Phase 0+) — same engine as Azure SQL, run locally via Docker.
# ---------------------------------------------------------------------------
MSSQL_SA_PASSWORD=Cheshire_secret_at_least8_upper_lower_digit
MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_DATABASE=previsit
MSSQL_USERNAME=sa
MSSQL_DRIVER=ODBC Driver 18 for SQL Server
MSSQL_IS_MANAGED=false

# ---------------------------------------------------------------------------
# Qdrant (Phase 0+) — local vector store, no account/API key needed.
# ---------------------------------------------------------------------------
QDRANT_HOST=localhost
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=note_chunks
QDRANT_URL=
QDRANT_API_KEY=

# ---------------------------------------------------------------------------
# Public/free-tier cloud deployment (e.g. Streamlit Community Cloud) —
# leave everything above at its local default for Docker Compose, and set
# these instead when pointing at hosted free tiers:
#
#   MSSQL_HOST=<your-server>.database.windows.net
#   MSSQL_USERNAME=<the admin login you chose when creating the Azure SQL
#                    logical server - Azure SQL Database does not use "sa">
#   MSSQL_IS_MANAGED=true   # skips CREATE DATABASE - create the database
#                           # itself in the Azure Portal, explicitly picking
#                           # the Free offer tier, BEFORE running the loader
#   QDRANT_URL=https://xyz-abc.cloud.qdrant.io:6333
#   QDRANT_API_KEY=<from the Qdrant Cloud cluster's API keys page>
#
# Everything else (Gemini key, embedding model, etc.) stays the same either
# way - only where the two databases live changes.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Embeddings (Phase 4) — local CPU model, no API key.
# ---------------------------------------------------------------------------
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ---------------------------------------------------------------------------
# LLM provider (Phase 5+) — swappable via LLM_PROVIDER. All free-tier, no card.
# Set only the key for the provider you're using; others may stay blank.
# ---------------------------------------------------------------------------
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.6-flash

# Google AI Studio free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq free tier: https://console.groq.com/keys
GROQ_API_KEY=

# Azure OpenAI — implemented for portability, NOT used by default.
# Requires an Azure subscription; do not fill these in unless you intend
# to pay. Left blank, azure_openai.py is simply never selected as provider.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=

# ---------------------------------------------------------------------------
# MLflow (Phase 6) — local SQLite-backed tracking, no server/account
# required. MLflow's plain filesystem backend ("./mlruns") is in
# maintenance mode as of 3.x and raises on use - SQLite is still fully
# local/free, just the currently-supported local storage mechanism.
# ---------------------------------------------------------------------------
MLFLOW_TRACKING_URI=sqlite:///mlruns.db

# ---------------------------------------------------------------------------
# Synthea (Phase 1) — synthetic patient generation.
# ---------------------------------------------------------------------------
SYNTHEA_POPULATION=1000
SYNTHEA_STATE=Arizona
SYNTHEA_OUTPUT_DIR=./data/synthea_output

# ---------------------------------------------------------------------------
# API (Phase 7)
# ---------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
